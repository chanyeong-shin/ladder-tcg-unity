# ==========================================================
# Unity .gitignore  —  게임개발실습 / ARENA BREAK
# Unity 프로젝트를 만들자마자 .gitattributes 와 함께 "첫 커밋"에 넣을 것.
# 이걸 빼고 커밋하면 Library/ 가 통째로 올라가 리포지토리가 수 GB가 되고
# 팀 전원이 머지 충돌을 겪는다.
# ==========================================================

# Unity가 매번 새로 만드는 폴더 (절대 커밋하지 않는다)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store 다운로드 캐시
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# 자동 생성되는 IDE/솔루션 파일
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# 빌드 산출물
*.apk
*.aab
*.unitypackage
*.app
ExportedObj/
crashlytics-build.properties
/[Ee]xported[Oo]bj/

# OS 부산물
.DS_Store
Thumbs.db
desktop.ini

# 백업
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
sysinfo.txt
*.stackdump
