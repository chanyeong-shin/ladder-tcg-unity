      m_Calls: []
  m_text: "3\uCC44\uB110 \uC0AC\uB2E4\uB9AC \uC704\uB85C \uD328\uD0B7\uC744 \uBCF4\uB0B4
    \uC0C1\uB300 \uC11C\uBC84 \uC14B\uC744 \uBAA8\uB450 \uB5A8\uC5B4\uB728\uB9B0\uB2E4.\n\uACF5\uACA9
    \uD134\uC5D0 \uBA3C\uC800 \uB193\uACE0, \uBC29\uC5B4 \uD134\uC774 \uBCF4\uACE0
    \uB300\uC751\uD55C \uB4A4, \uAC19\uC740 \uD134 \uB05D\uC5D0 \uB3D9\uC2DC \uBC1C\uB3D9\uD55C\uB2E4.\n\uAC19\uC740
